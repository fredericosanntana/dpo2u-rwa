{
  "name": "@dpo2u/rwa",
  "version": "0.1.0",
  "description": "Compliance signals and policy verdicts for tokenized real-world assets, built on the CoinMarketCap RWA API.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "dpo2u-rwa": "dist/cli.js", "dpo2u-rwa-mcp": "dist/mcp.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "registry", "policy"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsx src/cli.ts check",
    "snapshot": "tsx src/cli.ts snapshot",
    "mcp": "tsx src/mcp.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
